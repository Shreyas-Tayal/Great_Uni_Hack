{
  "name": "Foresight - Send email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-email",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "5d1d8218-8a86-4903-a3c7-534d7b176b77",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "ddbdfb7b-9483-4835-a0b9-8c9e85184bbe"
    },
    {
      "parameters": {
        "jsCode": "// SAFETY: this webhook is public (its URL is in the browser bundle). Only allowlisted addresses\n// get real email; anything else is redirected to the team demo inbox with a note.\nconst ALLOWED = ['PASTE_TEAM_EMAIL_1', 'PASTE_TEAM_EMAIL_2'];\nconst DEMO_INBOX = 'PASTE_TEAM_EMAIL_1';\nconst b = $input.first().json.body || {};\nconst to = String(b.to || '').trim().toLowerCase();\nconst ok = ALLOWED.map(x => x.toLowerCase()).includes(to);\nreturn [{ json: {\n  to: ok ? to : DEMO_INBOX,\n  subject: String(b.subject || 'Payment reminder').slice(0, 150),\n  body: (ok ? '' : `[Demo: originally addressed to ${to || 'nobody'}]\\n\\n`) + String(b.body || '').slice(0, 3000),\n  redirected: !ok,\n}}];"
      },
      "id": "df098ec0-6132-45c9-9392-b279e0052b51",
      "name": "Recipient allowlist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "id": "37ba77b2-2275-4827-843a-d706b7e3db38",
      "name": "Gmail send",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        440,
        300
      ],
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "jsCode": "const a = $('Recipient allowlist').first().json; return [{ json: { ok: true, sent_to: a.to, redirected: a.redirected } }];"
      },
      "id": "6960b461-66e1-4648-bd8b-9b790144dba8",
      "name": "OK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "17b8023b-9807-4819-a34c-7a1439927301",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
